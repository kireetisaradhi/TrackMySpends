{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "trackmyspends",
  "main": "./worker.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "731604",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
